{
  "name": "frappe-testpilot",
  "version": "0.1.3",
  "description": "CLI tool to help Frappe developers test custom apps before deploying them to production",
  "type": "module",
  "bin": {
    "frappe-testpilot": "src/index.js"
  },
  "scripts": {
    "dev": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "frappe",
