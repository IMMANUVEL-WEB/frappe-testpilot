    "testing",
    "bench",
    "erpnext"
  ],
  "author": "Immanuvel S",
  "license": "MIT",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
